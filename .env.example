# Copy to .env for docker compose / local runs. Never commit real secrets.
SENTINEL_ENVIRONMENT=local
SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@db:5432/sentinel
SENTINEL_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SENTINEL_FIELD_ENCRYPTION_KEY=
SENTINEL_CORS_ORIGINS=["http://localhost:3000"]
SENTINEL_COPILOT_PROVIDER=anthropic
SENTINEL_ANTHROPIC_API_KEY=
SENTINEL_OPENAI_API_KEY=
SENTINEL_SEED_PASSWORD=ChangeMe!2026
NEXT_PUBLIC_MAPBOX_TOKEN=
